DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=yourapp.herokuapp.com
CSRF_TRUSTED_ORIGINS=https://yourapp.herokuapp.com
DATABASE_URL=postgres://user:pass@host:5432/claimdesk
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=secret
DEFAULT_FROM_EMAIL=claims@yourdomain.com
# Optional SMS (pip install twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# File uploads: use a persistent volume or switch to S3 (django-storages) in production
MEDIA_ROOT=/data/media
